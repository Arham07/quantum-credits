# Lead delivery. Without RESEND_API_KEY the form validates normally but tells
# the visitor honestly that it is not connected and gives them the phone number
# — it never fakes a success. See src/app/actions.ts.
RESEND_API_KEY=

# Where consultation requests land.
LEAD_INBOX=hello@quantumcredit.io

# Must be a domain verified in Resend. The onboarding@resend.dev fallback only
# delivers to the Resend account owner, so it is fine for a smoke test and not
# for production.
LEAD_FROM="Quantum Credit <leads@quantumcredit.io>"
